# ─────────────────────────────────────────────────────────────────────────────
# AI Crime Intelligence & Investigation Platform — Environment Configuration
# Organization: Karnataka State Police (KSP)
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME="AI Crime Intelligence & Investigation Platform"
APP_VERSION="2.0.0"
LOG_LEVEL=INFO
SECRET_KEY=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://postgres:password@localhost:5432/crime_intel
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=finalcommit
NEO4J_MAX_CONNECTION_POOL_SIZE=30
NEO4J_CONNECTION_TIMEOUT=30

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=crime_vectors
QDRANT_VECTOR_SIZE=1024          # BGE-M3 = 1024 dims

# ── Embeddings (BGE-M3) ───────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu             # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=16

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=nvidia              # openai | google | ollama | nvidia
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-1.5-pro
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-embed-1b

# ── Authentication & RBAC ─────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER="KSP Crime Intelligence Platform"

# ── Blockchain Audit ─────────────────────────────────────────────────────────
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK_ID=ksp-crime-network
FABRIC_GATEWAY_URL=              # Set in production for Hyperledger Fabric
FABRIC_CHANNEL=crime-channel
FABRIC_CHAINCODE=crime-audit

# ── Zoho Catalyst ─────────────────────────────────────────────────────────────
ZOHO_CATALYST_PROJECT_ID=
ZOHO_CATALYST_API_TOKEN=
ZOHO_CATALYST_FILE_STORE_ID=
ZOHO_CATALYST_REGION=in

# ── Prompt Injection Firewall ────────────────────────────────────────────────
FIREWALL_ENABLED=true
FIREWALL_BLOCK_ON_INJECTION=true
FIREWALL_MAX_PAYLOAD_SIZE=65536

# ── Intelligence Engines ──────────────────────────────────────────────────────
PATTERN_MATCH_TOP_K=5
PATTERN_MATCH_SCORE_THRESHOLD=0.65
DBSCAN_EPS=0.5
DBSCAN_MIN_SAMPLES=3
HDBSCAN_MIN_CLUSTER_SIZE=5
EARLY_WARNING_ALERT_THRESHOLD=0.75
BIAS_CONFIDENCE_THRESHOLD=0.6

# ── Evidence Processing ───────────────────────────────────────────────────────
EVIDENCE_MAX_FILE_SIZE_MB=100
OCR_LANGUAGES=["en","kn"]        # English + Kannada
WHISPER_MODEL_SIZE=base          # tiny | base | small | medium | large
YOLO_CONFIDENCE_THRESHOLD=0.4

# ── Geospatial ────────────────────────────────────────────────────────────────
H3_RESOLUTION=8                  # ~0.74 km² per cell
GOOGLE_MAPS_API_KEY=             # Optional — for map tile overlays

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30